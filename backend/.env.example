# ==============================================================================
# Plantilla de variables de entorno - Backend (C++ / Drogon / mongocxx)
# INSTRUCCIONES:
#   1. Copia este archivo como "backend/.env" (ignorado por Git).
#   2. Sustituye los valores entre < > con los de tu cuenta de ejecucion
#      de MongoDB Atlas (usuario con privilegios minimos: readWrite en HotelDB).
#   3. NUNCA uses la cuenta administrativa de Atlas ni subas ".env" a Git.
# ==============================================================================

# Conexion a MongoDB Atlas (URI anonimizada de ejemplo)
MONGODB_URI=mongodb+srv://<USUARIO_APP>:<PASSWORD_SEGURA>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority&appName=HotelManagement
MONGODB_DB_NAME=HotelDB
MONGODB_MAX_POOL_SIZE=16
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Configuracion del servidor HTTP Drogon
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Seguridad HTTP / CORS (origen exacto del frontend Vite)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Nivel de registro (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO